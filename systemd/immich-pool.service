[Unit]
Description=Immich mergerfs pool
After=network-online.target remote-fs.target
Wants=network-online.target
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sleep 25
ExecStart=/home/immich/mount-pool.sh
ExecStop=/bin/umount /mnt/immich-pool

[Install]
WantedBy=multi-user.target
